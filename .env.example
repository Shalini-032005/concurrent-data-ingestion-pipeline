# PostgreSQL connection string (owned by Member 3 / database layer)
# Example: postgresql+asyncpg://user:password@localhost:5432/ingestion_db
# Supabase (direct connection): postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Supabase (pooler/pgbouncer):  postgresql+asyncpg://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Separate, disposable database for `pytest tests/test_database.py`.
# NEVER point this at your Supabase/production database.
# Example: postgresql+asyncpg://user:password@localhost:5432/ingestion_test
TEST_DATABASE_URL=

# Comma-separated list of allowed CORS origins for production
# Example: https://my-dashboard.vercel.app,https://my-dashboard-staging.vercel.app
CORS_ORIGINS=http://localhost:5173

# development | production
ENVIRONMENT=development

# --- Ingestion tuning (optional, sensible defaults exist in code) ---
# Per-source timeout in seconds
INGESTION_TIMEOUT=5

# Max attempts per source (including the first try)
MAX_RETRIES=3

# Base delay in seconds between retry attempts
RETRY_DELAY=0.5
