# Base URL of Member 1's FastAPI backend (no trailing slash).
VITE_API_URL=http://localhost:8000

# WebSocket URL for the /ws live-event stream.
# Use ws:// locally; MUST be wss:// once the dashboard is served over HTTPS.
VITE_WS_URL=ws://localhost:8000/ws

# When true, the dashboard runs entirely on deterministic mock data instead
# of calling the backend. Useful while Member 1's API isn't up yet.
# NEVER leave this "true" in a production deployment.
VITE_USE_MOCK_DATA=false
